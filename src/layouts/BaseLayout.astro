---
import Icon from '../components/Icon.astro';
import { withBase } from '../lib/content';
import '../styles/global.css';
interface Props { title?: string; description?: string; noindex?: boolean; article?: { published: Date; updated?: Date }; }
const { title, description = 'Clear, practical answers to frequently asked questions in power systems. Explore concepts, real-world examples, and the sources behind them.', noindex = false, article } = Astro.props;
const pageTitle = title ? `${title} | Power Systems FAQ` : 'Power Systems FAQ — Big questions. Clearer answers.';
const canonical = new URL(Astro.url.pathname, Astro.site);
const isFaq = Astro.url.pathname.includes('/faqs/');
const isAbout = Astro.url.pathname.endsWith('/about/');
const structuredData = article ? { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: title, description, datePublished: article.published.toISOString(), dateModified: (article.updated || article.published).toISOString(), url: canonical.href, mainEntityOfPage: canonical.href } : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f5f3eb" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#18201c" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title="Power Systems FAQ" href={withBase('rss.xml')} />
    <link rel="sitemap" href={withBase('sitemap-index.xml')} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content="Power Systems FAQ" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="header-inner container">
        <a class="brand" href={withBase()} aria-label="Power Systems FAQ home"><span class="brand-mark"><Icon name="bolt" size={23}/></span><span>Power Systems <span class="brand-faq">FAQ</span></span></a>
        <nav aria-label="Main navigation"><a href={withBase('faqs/')} aria-current={isFaq ? 'page' : undefined}>FAQs</a><a href={withBase('faqs/#topics')}>Topics</a><a href={withBase('about/')} aria-current={isAbout ? 'page' : undefined}>About</a><a class="nav-source" href="https://github.com/Plusero/powersys-faq">GitHub <Icon name="external" size={14}/></a></nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer container">
      <div><a class="footer-brand" href={withBase()}>Power Systems FAQ<span class="small-dot"></span></a><p>Built for curiosity. Grounded in power systems.</p></div>
      <div class="footer-links"><a href={withBase('rss.xml')}><Icon name="rss" size={15}/>RSS feed</a><a href="https://github.com/Plusero/powersys-faq">View source <Icon name="external" size={14}/></a></div>
    </footer>
  </body>
</html>
